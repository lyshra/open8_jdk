+        JCExpression fn = make.Select(make.QualIdent(jt.tsym), msym);
+        fn.type = msym.type;
+        JCMethodInvocation app = make.App(fn, args);
+        app.type = jt;
+        return app;
+    }
+
+    // Helper: create instance method call like target.get(arg)
