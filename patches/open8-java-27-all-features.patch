+    /** Check if a type is the java.json.Json type. Uses name comparison for module-safety. */
+    private boolean isJsonType(Type t) {
+        if (t == null || t.tsym == null) return false;
+        return t.tsym.flatName().toString().equals("java.json.Json");
+    }
+
+    /** Resolve the java.json.Json type. Caches in syms.jsonType. */
+    private Type resolveJsonType() {
+        if (syms.jsonType != null) return syms.jsonType;
+        ModuleSymbol jsonModule = syms.enterModule(names.fromString("java.json"));
+        ClassSymbol cs = syms.enterClass(jsonModule, names.fromString("java.json.Json"));
+        if (cs != null && cs.type != null) {
+            syms.jsonType = cs.type;
+        }
+        return syms.jsonType;
+    }
+
+    // Helper: create a static method call like Json.of(arg) or Json.ofEntries(args)
+    private JCExpression jsonStaticCall(Name methodName, List<JCExpression> args) {
+        Type jt = resolveJsonType();
+        MethodSymbol msym = lookupMethod(make_pos, methodName, jt,
